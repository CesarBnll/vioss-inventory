<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/images/logo_blue.png"/>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"/>
    
    <!-- Propietary CSS -->
    <link rel="stylesheet" href="/stylesheets/main.css">
    <link rel="stylesheet" href="/stylesheets/recovery.css">
</head>
<body>
    <form action="/login/recovery" method="post" class="position-absolute top-50 start-50 translate-middle">
        <div class="d-flex">
            <img src="/images/logo_white.png" class="mx-auto mt-5 mb-4 img-fluid" alt="Vioss GPS">
        </div>
        <h3 class="text-center"><%= title %></h3>
        <div class="wrap-input my-3">
            <label for="email" class="form-label"><span class="fa-solid fa-user fa-form ms-2 me-2 mb-0"></span>Usuario:</label>
            <input type="email" class="form-control" placeholder="vioss@gps.com" name="email">
        </div>
        <div>
            <label for="pwd" class="form-label"><span class="fa-solid fa-lock fa-form me-2 mb-0"></span>Nueva Contraseña:</label>
            <input type="password" class="form-control" id="pwd" placeholder="********" name="pass">
        </div>

        <div class="d-flex justify-content-center mt-4">
            <button type="submit" class="btn px-60">Continuar</button>
        </div>

        <% if (message == "missing") { %>
            <div class="alert alert-warning mt-4" role="alert">
                Por favor rellene todos los campos!
            </div>
        <% } else if (message == "false") { %>
            <div class="alert alert-danger mt-4" role="alert">
                Usuario incorrecto!
            </div>
        <% } %>
    </form>
</body>
</html>
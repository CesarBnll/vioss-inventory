<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/images/vioss-circle.png" sizes="any"/>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <!-- Propietary CSS -->
    <link rel="stylesheet" href="/stylesheets/main.css">
    <link rel="stylesheet" href="/stylesheets/admin.css">
  </head>
  <body>
    <header class="admin-mobile-header">
      <a class="admin-brand" href="/admin">Vioss Administrativo</a>
      <button class="admin-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Abrir navegación">
        <i class="fa-solid fa-bars"></i>
      </button>
    </header>

    <aside class="admin-sidebar offcanvas offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarTitle">
      <div class="offcanvas-header admin-sidebar-header">
        <h1 class="offcanvas-title" id="adminSidebarTitle">Vioss Administrativo</h1>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar navegación"></button>
      </div>
      <nav class="offcanvas-body admin-navigation" aria-label="Navegación administrativa">
        <button class="nav-link active" id="v-pills-inventory-tab" data-bs-toggle="pill" data-bs-target="#v-pills-inventory" type="button" role="tab" aria-controls="v-pills-inventory" aria-selected="true">
          <i class="fa-solid fa-house me-1"></i>
          <span>Activos</span>
        </button>
        <button class="nav-link" id="v-pills-users-tab" data-bs-toggle="pill" data-bs-target="#v-pills-users" type="button" role="tab" aria-controls="v-pills-users" aria-selected="false">
          <i class="fa-solid fa-user me-1"></i>
          <span>Usuarios</span>
        </button>
        <button class="nav-link" id="v-pills-history-tab" data-bs-toggle="pill" data-bs-target="#v-pills-history" type="button" role="tab" aria-controls="v-pills-history" aria-selected="false">
          <i class="fa-solid fa-clock-rotate-left me-1"></i>
          <span>Historial</span>
        </button>
        <button class="nav-link" id="v-pills-actions-tab" data-bs-toggle="pill" data-bs-target="#v-pills-actions" type="button" role="tab" aria-controls="v-pills-actions" aria-selected="false">
          <i class="fa-solid fa-gear me-1"></i>
          <span>Acciones</span>
        </button>
        <form action="/admin/logout" id="v-pills-logout-form" method="post">
          <button type="submit" class="nav-link" id="v-pills-logout-tab" data-bs-toggle="pill" data-bs-target="#v-pills-logout" type="button" role="tab" aria-controls="v-pills-logout" aria-selected="false">
            <i class="fa-solid fa-sign-out-alt me-1"></i>
            <span>Salir</span>
          </button>
        </form>
      </nav>
    </aside>

    <div class="d-flex">
      <div class="nav flex-column nav-pills text-left" id="v-pills-tab" role="tablist" aria-orientation="vertical">
        <img src="/images/logo_white.png" alt="Logo de Vioss" class="img-fluid mt-3 mb-5">
        <button class="nav-link active" id="v-pills-inventory-tab" data-bs-toggle="pill" data-bs-target="#v-pills-inventory" type="button" role="tab" aria-controls="v-pills-inventory" aria-selected="true">
          <i class="fa-solid fa-house me-1 nav-icon"></i>
          <span class="nav-label">Activos</span>
        </button>
        <button class="nav-link" id="v-pills-users-tab" data-bs-toggle="pill" data-bs-target="#v-pills-users" type="button" role="tab" aria-controls="v-pills-users" aria-selected="false">
          <i class="fa-solid fa-user me-1 nav-icon"></i>
          <span class="nav-label">Usuarios</span>
        </button>
        <button class="nav-link" id="v-pills-history-tab" data-bs-toggle="pill" data-bs-target="#v-pills-history" type="button" role="tab" aria-controls="v-pills-history" aria-selected="false">
          <i class="fa-solid fa-clock-rotate-left me-1 nav-icon"></i>
          <span class="nav-label">Historial</span>
        </button>
        <button class="nav-link" id="v-pills-actions-tab" data-bs-toggle="pill" data-bs-target="#v-pills-actions" type="button" role="tab" aria-controls="v-pills-actions" aria-selected="false">
          <i class="fa-solid fa-gear me-1 nav-icon"></i>
          <span class="nav-label">Acciones</span>
        </button>
        <form action="/admin/logout" id="v-pills-logout-form" method="post">
          <button type="submit" class="nav-link" id="v-pills-logout-tab" data-bs-toggle="pill" data-bs-target="#v-pills-logout" type="button" role="tab" aria-controls="v-pills-logout" aria-selected="false">
            <i class="fa-solid fa-sign-out-alt me-1 nav-icon"></i>
            <span class="nav-label">Salir</span>
          </button>
        </form>
      </div>
      <div class="tab-content" id="v-pills-tabContent">
        <div class="tab-pane fade show active" id="v-pills-inventory" role="tabpanel" aria-labelledby="v-pills-inventory-tab" tabindex="0">Inventory</div>
        <div class="tab-pane fade" id="v-pills-users" role="tabpanel" aria-labelledby="v-pills-users-tab" tabindex="0">
          <div class="text-center mt-4 mb-4">
            <span class="align-middle" style="font-size: 2.5rem;"style="font-size: 2.5rem;">
              <i class="fa solid fa-users" style="font-size: 5rem;"></i>
                  Usuarios: <%= users.length %>
            </span>
          </div>
          <div class="row">
            <div class="col-md-4">
              <div class="input-group mb-3">
                <span class="input-group-text" id="search-addon"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" class="form-control" placeholder="Buscar..." aria-label="search" aria-describedby="search-addon">
              </div>
            </div>
            <div class="col-md-8 text-end mb-3">
              <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addUserModal">
                <i class="fa-solid fa-user-plus"></i> Agregar Usuario
              </button> 
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-dark">
                <tr>
                  <th scope="col">Nombre</th>
                  <th scope="col">Email</th>
                  <th scope="col">Teléfono</th>
                  <th scope="col">Rol</th>
                  <th scope="col">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(user => { %>
                  <tr class="align-middle">
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.phone %></td>
                    <td><%= user.type %></td>
                    <td>
                      <button class="btn btn-sm btn-outline-primary">Editar</button>
                      <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>  
          </div>
          
          <!-- 
          <form action="/admin/add_user" method="post">
            <div class="mb-3">
              <label for="user-name" class="form-label">Nombre</label>
              <input type="text" class="form-control" id="user-name" name="name" required>
            </div>
            <div class="mb-3">
              <label for="user-email" class="form-label">Email</label>
              <input type="email" class="form-control" id="user-email" name="email" required>
            </div>
            <div class="mb-3">
              <label for="user-password" class="form-label">Contraseña</label>
              <input type="password" class="form-control" id="user-password" name="password" required>
            </div>
            <button type="submit" class="btn btn-primary">Agregar Usuario</button>
          </form>
          -->
        </div>
        <div class="tab-pane fade" id="v-pills-history" role="tabpanel" aria-labelledby="v-pills-history-tab" tabindex="0">History</div>
        <div class="tab-pane fade" id="v-pills-actions" role="tabpanel" aria-labelledby="v-pills-actions-tab" tabindex="0">Actions</div>
      </div>
    </div>
  </body>
</html>
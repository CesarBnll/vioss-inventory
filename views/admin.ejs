<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/images/vioss-circle.png" sizes="any"/>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <!-- Propietary CSS -->
    <link rel="stylesheet" href="/stylesheets/main.css">
    <link rel="stylesheet" href="/stylesheets/admin.css">
  </head>
  <body>
    <% if (message) { %>
      <div id="admin-feedback" class="alert alert-<%= message.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show admin-feedback" role="alert" aria-live="polite">
        <%= message.text %>
      </div>
    <% } %>

    <header class="admin-mobile-header">
      <a class="admin-brand" href="/admin">Vioss Administrativo</a>
      <button class="admin-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Abrir navegación">
        <i class="fa-solid fa-bars"></i>
      </button>
    </header>

    <aside class="admin-sidebar offcanvas offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarTitle">
      <div class="offcanvas-header admin-sidebar-header">
        <h1 class="offcanvas-title" id="adminSidebarTitle">Vioss Administrativo</h1>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar navegación"></button>
      </div>
      <nav class="offcanvas-body admin-navigation nav-pills" role="tablist" aria-orientation="vertical" aria-label="Navegación administrativa">
        <button class="nav-link <%= activeTab === 'inventory' ? 'active' : '' %>" id="v-pills-inventory-mobile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-inventory" type="button" role="tab" aria-controls="v-pills-inventory" aria-selected="<%= activeTab === 'inventory' %>">
          <i class="fa-solid fa-house me-1"></i>
          <span>Activos</span>
        </button>
        <button class="nav-link <%= activeTab === 'users' ? 'active' : '' %>" id="v-pills-users-mobile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-users" type="button" role="tab" aria-controls="v-pills-users" aria-selected="<%= activeTab === 'users' %>">
          <i class="fa-solid fa-user me-1"></i>
          <span>Usuarios</span>
        </button>
        <button class="nav-link <%= activeTab === 'history' ? 'active' : '' %>" id="v-pills-history-mobile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-history" type="button" role="tab" aria-controls="v-pills-history" aria-selected="<%= activeTab === 'history' %>">
          <i class="fa-solid fa-clock-rotate-left me-1"></i>
          <span>Historial</span>
        </button>
        <button class="nav-link <%= activeTab === 'actions' ? 'active' : '' %>" id="v-pills-actions-mobile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-actions" type="button" role="tab" aria-controls="v-pills-actions" aria-selected="<%= activeTab === 'actions' %>">
          <i class="fa-solid fa-gear me-1"></i>
          <span>Acciones</span>
        </button>
        <button type="button" class="nav-link" id="v-pills-logout-tab" data-bs-toggle="modal" data-bs-target="#logoutModal" role="tab" aria-controls="v-pills-logout" aria-selected="false">
          <i class="fa-solid fa-sign-out-alt me-1"></i>
          <span>Salir</span>
        </button>
      </nav>
    </aside>

    <div class="d-flex">
      <div class="nav flex-column nav-pills text-left" id="v-pills-tab" role="tablist" aria-orientation="vertical">
        <img src="/images/logo_white.png" alt="Logo de Vioss" class="img-fluid mt-3 mb-5">
        <button class="nav-link <%= activeTab === 'inventory' ? 'active' : '' %>" id="v-pills-inventory-tab" data-bs-toggle="pill" data-bs-target="#v-pills-inventory" type="button" role="tab" aria-controls="v-pills-inventory" aria-selected="<%= activeTab === 'inventory' %>">
          <i class="fa-solid fa-house me-1 nav-icon"></i>
          <span class="nav-label">Activos</span>
        </button>
        <button class="nav-link <%= activeTab === 'users' ? 'active' : '' %>" id="v-pills-users-tab" data-bs-toggle="pill" data-bs-target="#v-pills-users" type="button" role="tab" aria-controls="v-pills-users" aria-selected="<%= activeTab === 'users' %>">
          <i class="fa-solid fa-user me-1 nav-icon"></i>
          <span class="nav-label">Usuarios</span>
        </button>
        <button class="nav-link <%= activeTab === 'history' ? 'active' : '' %>" id="v-pills-history-tab" data-bs-toggle="pill" data-bs-target="#v-pills-history" type="button" role="tab" aria-controls="v-pills-history" aria-selected="<%= activeTab === 'history' %>">
          <i class="fa-solid fa-clock-rotate-left me-1 nav-icon"></i>
          <span class="nav-label">Historial</span>
        </button>
        <button class="nav-link <%= activeTab === 'actions' ? 'active' : '' %>" id="v-pills-actions-tab" data-bs-toggle="pill" data-bs-target="#v-pills-actions" type="button" role="tab" aria-controls="v-pills-actions" aria-selected="<%= activeTab === 'actions' %>">
          <i class="fa-solid fa-gear me-1 nav-icon"></i>
          <span class="nav-label">Acciones</span>
        </button>
        <button type="button" class="nav-link" id="v-pills-logout-modal" data-bs-toggle="modal" data-bs-target="#logoutModal" aria-controls="v-pills-logout" aria-selected="false">
          <i class="fa-solid fa-sign-out-alt me-1 nav-icon"></i>
          <span class="nav-label">Salir</span>
        </button>
      </div>

      <div class="modal fade" id="logoutModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5" id="logoutModalLabel">Cerrar Sesión</h1>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              ¿Estás seguro de que quieres salir?
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <form action="/admin/logout" id="logoutForm" method="post">
                <button type="submit" class="btn btn-primary">Aceptar</button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <div class="tab-content" id="v-pills-tabContent">
        <div class="tab-pane fade <%= activeTab === 'inventory' ? 'show active' : '' %>" id="v-pills-inventory" role="tabpanel" aria-labelledby="v-pills-inventory-tab" tabindex="0">Inventory</div>

        <div class="tab-pane fade <%= activeTab === 'users' ? 'show active' : '' %>" id="v-pills-users" role="tabpanel" aria-labelledby="v-pills-users-tab" tabindex="0">
          <div class="text-center align-middle mt-4 mb-4">
            <i class="fa-solid fa-users fs-1"></i>
            <span class="fs-2 ms-2">Usuarios: <%= users.length %></span>
          </div>

          <div class="row">
            <div class="col-md-4">
              <div id="tableSearch" class="input-group mb-3">
                <span class="input-group-text" id="search-addon"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" class="form-control" placeholder="Buscar..." onkeyup="filterTable()" aria-label="search" aria-describedby="search-addon">
              </div>
            </div>
            <div class="col-md-8 text-end mb-3">
              <button id="addUserBtn" class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addUserModal">
                <i class="fa-solid fa-user-plus"></i> Agregar Usuario
              </button> 
            </div>
          </div>

          <div class="modal fade" id="addUserModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h1 class="modal-title fs-5" id="addUserModalLabel">Agregar Usuario</h1>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <form action="/admin/add_user" method="post" class="row g-3">
                    <div class="col-md-6">
                      <label for="name" class="form-label">Nombre y Apellido</label>
                      <input type="text" class="form-control" id="name" name="name" required>
                    </div>
                    <div class="col-md-6">
                      <label for="phone" class="form-label">Teléfono</label>
                      <input type="tel" class="form-control" id="phone" name="phone" required>
                    </div>
                    <div class="col-md-6">
                      <label for="email" class="form-label">Email</label>
                      <input type="email" class="form-control" id="email" name="email" required>
                    </div>
                    <div class="col-md-6">
                      <label for="password" class="form-label">Contraseña</label>
                      <input type="password" class="form-control" id="pass" name="pass" required>
                    </div>
                    <div class="col-md-12">
                      <label for="type" class="form-label">Rol</label>
                      <select class="form-select" id="type" name="type" required>
                        <option disabled>Seleccionar rol</option>
                        <option value="admin">Administrador</option>
                        <option value="user">Usuario</option>
                      </select>
                    </div>
                    <div class="col-md-12 mt-4 mb-2 text-center"> 
                      <button type="button" id="addUserCancelBtn"class="btn btn-secondary col-md-5 me-3" data-bs-dismiss="modal">Cancelar</button>
                      <button type="submit" id="addUserConfirmBtn" class="btn btn-primary col-md-5 fw-bold">Confirmar</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-dark">
                <tr>
                  <th scope="col">Nombre</th>
                  <th scope="col">Email</th>
                  <th scope="col">Teléfono</th>
                  <th scope="col">Rol</th>
                  <th style="width: 160px;" scope="col">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(user => { %>
                  <tr class="align-middle text-nowrap">
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.phone %></td>
                    <% if (user.type === 'admin') { %>
                      <td>Administrador</td>
                    <% } else { %>
                      <td>Usuario</td>
                    <% } %>
                    <td>
                      <button class="btn btn-sm btn-outline-primary">Editar</button>
                      <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>  
          </div>
        </div>

        <div class="tab-pane fade <%= activeTab === 'history' ? 'show active' : '' %>" id="v-pills-history" role="tabpanel" aria-labelledby="v-pills-history-tab" tabindex="0">History</div>

        <div class="tab-pane fade <%= activeTab === 'actions' ? 'show active' : '' %>" id="v-pills-actions" role="tabpanel" aria-labelledby="v-pills-actions-tab" tabindex="0">Actions</div>
      </div>
    </div>
    <script>
      document.querySelectorAll('[data-bs-toggle="pill"]').forEach(tabButton => {
        tabButton.addEventListener('shown.bs.tab', event => {
          const selectedTarget = event.target.getAttribute('data-bs-target');
          document.querySelectorAll('[data-bs-toggle="pill"]').forEach(button => {
            const isSelected = button.getAttribute('data-bs-target') === selectedTarget;
            button.classList.toggle('active', isSelected);
            button.setAttribute('aria-selected', String(isSelected));
          });
        });
      });
    </script>
    <% if (message) { %>
      <script>
        window.setTimeout(() => {
          const feedback = document.getElementById('admin-feedback');
          if (feedback) {
            bootstrap.Alert.getOrCreateInstance(feedback).close();
          }
        }, 4000);
      </script>
    <% } %>
  </body>
</html>